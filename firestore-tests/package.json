{
  "name": "fund-circle-firestore-rules-tests",
  "private": true,
  "description": "Emulator-backed allow/deny tests for the root firestore.rules",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test --test-reporter=spec rules.test.mjs",
    "test:emulator": "firebase --config ../firebase.json emulators:exec --only firestore --project demo-fundcircle \"npm test\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "3.0.4",
    "firebase": "10.14.1",
    "firebase-tools": "13.29.1"
  }
}
