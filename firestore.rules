rules_version = '2';

// ===============================================================
// Fund Circle — Production Cloud Firestore Security Rules
// ===============================================================
// Target Platform: Android 8.0+ (Min SDK 26, Target SDK 35, Compile SDK 35)
// Backend Architecture: 100% Serverless BaaS on Firebase Spark Plan ($0 Free Tier)
//
// Core Architectural & Security Invariants:
// 1. Invariant 1 (Whole-Integer Money): All amounts strictly 64-bit int >= 1. Zero decimals/poisha.
// 2. Invariant 2 ($O(1)$ Atomic Aggregates): Single-doc read dashboard. Circle creation enforces
//    totalDeposits == 0, totalExpenses == 0, recordedBalance == 0. Currency locked permanently.
// 3. Invariant 3 (Multi-Tenant Physical Isolation & Zero-Read Tenant Authorization):
//    All circle assets isolated under /funds/{fundId}/...
//    Zero-read O(1) membership check: getUserEmail() in fundData.memberEmails.
// 4. Invariant 4 (Immutable Audit Trail - Zero Hard Deletes):
//    Financial records cannot be deleted (allow delete: if false;).
//    Reversals restricted strictly to audit metadata via affectedKeys().hasOnly([...]).
// 5. Invariant 6 (User Data Separation & PII Protection):
//    KYC PII (/funds/{fundId}/members/{userId}/kyc/identity) restricted strictly to Circle Admin or owner.
//    User profiles (/users/{userId}) restricted strictly to the authenticated user.
// ===============================================================

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: /funds/{fundId}
// Document ID: fundId (UUIDv4)
// Fields:
//   - fundId: string (immutable) - Circle UUIDv4 identifier
//   - name: string - Circle display name
//   - description: string - Circle description
//   - currency: string ('BDT' | 'USD' | 'EUR', permanently locked) - Base currency
//   - adminId: string - Circle Admin UID
//   - adminEmail: string - Circle Admin Email
//   - memberEmails: list of strings - Zero-read tenant authorization vector
//   - memberCount: int - Total member count in circle
//   - totalDeposits: int (whole integer >= 0, initially 0) - Atomic aggregate deposits
//   - totalExpenses: int (whole integer >= 0, initially 0) - Atomic aggregate expenses
//   - recordedBalance: int (whole integer, initially 0) - Atomic aggregate net balance
//   - isLocked: bool (initially false) - Emergency freeze toggle
//   - createdAt: int (epoch ms, immutable) - Creation timestamp
//   - updatedAt: int (epoch ms) - Last update timestamp
//
// Subcollection: /funds/{fundId}/members/{userId}
// Document ID: userId (Firebase Auth UID)
// Fields:
//   - userId: string - Member Auth UID
//   - memberId: string (e.g. 'FC-001') - Sequential member identifier
//   - email: string - Member email address
//   - name: string - Member display name
//   - role: string ('ADMIN' | 'MEMBER') - Member role
//   - status: string ('PENDING' | 'ACTIVE' | 'INACTIVE' | 'LEFT') - Member status
//   - totalContributed: int (whole integer >= 0) - Sum of active deposits, moved only with a deposit or its reversal
//   - depositCount: int (>= 0) - Number of active deposits, moved with totalContributed
//   - joinedAt: int (epoch ms) - Joining timestamp
//   - lastActiveAt: int (epoch ms) - Last activity timestamp
//
// Subcollection: /funds/{fundId}/members/{userId}/kyc/identity
// Document ID: 'identity'
// Fields:
//   - userId: string - Member Auth UID
//   - nidNumber: string - National Identity Number (PII)
//   - nomineeName: string - Nominee full name
//   - nomineePhone: string - Nominee contact phone
//   - nomineeRelation: string - Relationship to member
//   - verifiedByAdmin: bool - Admin verification flag
//   - updatedAt: int (epoch ms) - Last update timestamp
//
// Subcollection: /funds/{fundId}/deposits/{depositId}
// Document ID: depositId (UUIDv4)
// Fields:
//   - depositId: string - Deposit UUIDv4
//   - fundId: string - Parent Fund UUIDv4
//   - memberId: string - Contributor Member UID
//   - memberEmail: string - Contributor Email
//   - memberName: string - Contributor Name
//   - amount: int (whole positive integer >= 1, immutable) - Contribution amount
//   - depositDate: int (epoch ms <= request.time) - Transaction date
//   - paymentMethod: string - Payment method
//   - note: string - Notes
//   - isVoid: bool (initially false) - Void flag
//   - voidReason: string - Reversal reason
//   - voidedAt: int (epoch ms) - Reversal timestamp
//   - voidedBy: string - Admin email who reversed
//   - correctionHistory: list of maps - Audit diff trail
//   - createdAt: int (epoch ms) - Creation timestamp
//
// Subcollection: /funds/{fundId}/expenses/{expenseId}
// Document ID: expenseId (UUIDv4)
// Fields:
//   - expenseId: string - Expense UUIDv4
//   - fundId: string - Parent Fund UUIDv4
//   - amount: int (whole positive integer >= 1, immutable) - Expense amount
//   - expenseDate: int (epoch ms <= request.time) - Transaction date
//   - category: string - Expense category
//   - description: string - Expense description
//   - paymentMethod: string - Payment method
//   - paidBy: string - Vendor or payee name
//   - createdBy: string - Creator UID
//   - creatorEmail: string - Creator Email
//   - isVoid: bool (initially false) - Void flag
//   - voidReason: string - Reversal reason
//   - voidedAt: int (epoch ms) - Reversal timestamp
//   - voidedBy: string - Admin email who reversed
//   - correctionHistory: list of maps - Audit diff trail
//   - createdAt: int (epoch ms) - Creation timestamp
//
// Subcollection: /funds/{fundId}/audit_logs/{logId}
// Document ID: logId (UUIDv4 or auto-generated)
// Fields:
//   - logId: string
//   - fundId: string
//   - action: string
//   - actorId: string
//   - actorEmail: string
//   - details: string
//   - timestamp: int
//
// Collection: /users/{userId}
// Document ID: userId (Firebase Auth UID)
// Fields:
//   - userId: string - User UID
//   - email: string - Google Account Email
//   - displayName: string - Display name
//   - photoUrl: string - Profile picture URL
//   - createdCircleCount: int - Created circle counter
//   - createdAt: int - Creation timestamp
//   - lastActiveAt: int - Last active timestamp
//
// Subcollection: /users/{userId}/invitations/{invitationId}
// Document ID: invitationId (UUIDv4)
// Fields:
//   - invitationId: string - Invitation ID
//   - fundId: string - Circle ID
//   - fundName: string - Circle Name
//   - invitedByEmail: string - Sender email
//   - assignedRole: string - Assigned role
//   - status: string - Status
//   - createdAt: int - Creation timestamp
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Identity helpers
    // ---------------------------------------------------------------
    // Email (lower-cased) is the member identity. Invited members are
    // stored before they ever sign in, so their member document ID cannot
    // be their Auth UID; every self-service check therefore matches on
    // the verified Google account email.
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasEmail() {
      return isAuthenticated() && request.auth.token.email is string;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function fundPath(fundId) {
      return /databases/$(database)/documents/funds/$(fundId);
    }

    function txPath(fundId, collection, txId) {
      return /databases/$(database)/documents/funds/$(fundId)/$(collection)/$(txId);
    }

    function memberPath(fundId, memberDocId) {
      return /databases/$(database)/documents/funds/$(fundId)/members/$(memberDocId);
    }

    // Zero-read tenant authorization (Invariant 3)
    function isMemberOf(fund) {
      return hasEmail()
        && (myEmail() in fund.memberEmails || request.auth.token.email in fund.memberEmails);
    }

    // Admin is identified by UID (circle creator) or by email (after an
    // ownership transfer to an invited member whose UID was never known).
    function isAdminOf(fund) {
      return hasEmail()
        && (request.auth.uid == fund.adminId || myEmail() == fund.adminEmail.lower());
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isWholeAmount(value) {
      return value is int && value >= 1;
    }

    // Allow 5 minutes of device clock skew; the client already rejects future dates.
    function notInFuture(epochMs) {
      return epochMs is int && epochMs <= request.time.toMillis() + 300000;
    }

    // ---------------------------------------------------------------
    // /funds/{fundId} — parent aggregate document
    // ---------------------------------------------------------------
    // Aggregates may only move together with the exact ledger document
    // that justifies the change. Every aggregate write names that document
    // in `lastTxId`, and the ledger rule checks the reverse direction, so
    // a deposit/expense/void and its increment are inseparable (Invariant 2).

    function validNewFund(fundId) {
      let d = request.resource.data;
      return hasEmail()
        && d.keys().hasOnly(['fundId', 'name', 'description', 'currency', 'adminId', 'adminEmail',
                             'memberEmails', 'memberCount', 'totalDeposits', 'totalExpenses',
                             'recordedBalance', 'isLocked', 'createdAt', 'updatedAt'])
        && d.fundId == fundId
        && d.name is string && d.name.size() > 0
        && d.currency in ['BDT', 'USD', 'EUR']
        && d.adminId == request.auth.uid
        && d.adminEmail == myEmail()
        && d.memberEmails == [myEmail()]
        && d.memberCount == 1
        && d.totalDeposits == 0
        && d.totalExpenses == 0
        && d.recordedBalance == 0
        && d.isLocked == false;
    }

    // A member records a deposit: totals rise by exactly the new deposit's amount.
    function isDepositRecord(fundId) {
      let before = resource.data;
      let after = request.resource.data;
      let path = txPath(fundId, 'deposits', after.lastTxId);
      let delta = after.totalDeposits - before.totalDeposits;
      return changed().hasOnly(['totalDeposits', 'recordedBalance', 'updatedAt', 'lastTxId'])
        && before.isLocked == false
        && delta >= 1
        && after.recordedBalance - before.recordedBalance == delta
        && !exists(path)
        && existsAfter(path)
        && getAfter(path).data.amount == delta;
    }

    // The admin records an expense: expenses rise and balance falls by its amount.
    function isExpenseRecord(fundId) {
      let before = resource.data;
      let after = request.resource.data;
      let path = txPath(fundId, 'expenses', after.lastTxId);
      let delta = after.totalExpenses - before.totalExpenses;
      return isAdminOf(before)
        && changed().hasOnly(['totalExpenses', 'recordedBalance', 'updatedAt', 'lastTxId'])
        && before.isLocked == false
        && delta >= 1
        && before.recordedBalance - after.recordedBalance == delta
        && !exists(path)
        && existsAfter(path)
        && getAfter(path).data.amount == delta;
    }

    // The admin reverses a deposit: totals fall by the deposit's original amount,
    // and only while that deposit flips from active to void in the same write.
    function isDepositVoid(fundId) {
      let before = resource.data;
      let after = request.resource.data;
      let path = txPath(fundId, 'deposits', after.lastTxId);
      let delta = before.totalDeposits - after.totalDeposits;
      return isAdminOf(before)
        && changed().hasOnly(['totalDeposits', 'recordedBalance', 'updatedAt', 'lastTxId'])
        && before.isLocked == false
        && delta >= 1
        && before.recordedBalance - after.recordedBalance == delta
        && get(path).data.get('isVoid', false) == false
        && getAfter(path).data.isVoid == true
        && get(path).data.amount == delta;
    }

    // The admin reverses an expense: expenses fall and balance is restored.
    function isExpenseVoid(fundId) {
      let before = resource.data;
      let after = request.resource.data;
      let path = txPath(fundId, 'expenses', after.lastTxId);
      let delta = before.totalExpenses - after.totalExpenses;
      return isAdminOf(before)
        && changed().hasOnly(['totalExpenses', 'recordedBalance', 'updatedAt', 'lastTxId'])
        && before.isLocked == false
        && delta >= 1
        && after.recordedBalance - before.recordedBalance == delta
        && get(path).data.get('isVoid', false) == false
        && getAfter(path).data.isVoid == true
        && get(path).data.amount == delta;
    }

    // The admin manages profile, lock, membership list and ownership transfer.
    // Aggregates, currency and identity fields are untouchable here.
    function isAdminGovernance() {
      let after = request.resource.data;
      return isAdminOf(resource.data)
        && changed().hasOnly(['name', 'description', 'isLocked', 'memberCount', 'memberEmails',
                              'adminId', 'adminEmail', 'updatedAt'])
        && after.name is string && after.name.size() > 0
        && after.isLocked is bool
        && after.memberEmails is list
        && after.memberCount is int && after.memberCount >= 1
        && after.adminEmail is string
        && (after.adminEmail in after.memberEmails || after.adminEmail.lower() in after.memberEmails);
    }

    match /funds/{fundId} {
      allow read: if isMemberOf(resource.data);
      allow create: if validNewFund(fundId);
      allow update: if isMemberOf(resource.data)
                    && !changed().hasAny(['fundId', 'currency', 'createdAt']) // Currency locked permanently
                    && (isDepositRecord(fundId)
                        || isExpenseRecord(fundId)
                        || isDepositVoid(fundId)
                        || isExpenseVoid(fundId)
                        || isAdminGovernance());
      allow delete: if false; // Zero hard deletes (Invariant 4)

      // -------------------------------------------------------------
      // Members subcollection
      // -------------------------------------------------------------
      function memberKeysValid(d) {
        return d.keys().hasOnly(['userId', 'memberId', 'email', 'name', 'phone', 'role', 'status',
                                 'totalContributed', 'depositCount', 'joinedAt', 'lastActiveAt',
                                 'updatedAt'])
          && d.role in ['ADMIN', 'MEMBER']
          && d.status in ['PENDING', 'ACTIVE', 'INACTIVE', 'LEFT']
          && d.email is string && d.email == d.email.lower()
          && d.totalContributed == 0
          && d.get('depositCount', 0) == 0;
      }

      // Circle creation batch: the creator's own ADMIN member document.
      function isCreatorMemberCreate(memberDocId) {
        let d = request.resource.data;
        return hasEmail()
          && !exists(fundPath(fundId))
          && getAfter(fundPath(fundId)).data.adminId == request.auth.uid
          && memberDocId == request.auth.uid
          && d.userId == memberDocId
          && d.role == 'ADMIN'
          && d.email == myEmail()
          && memberKeysValid(d);
      }

      // Admin invites a MEMBER whose email is added to memberEmails in the same batch.
      function isInviteCreate(memberDocId) {
        let d = request.resource.data;
        return isAdminOf(get(fundPath(fundId)).data)
          && d.userId == memberDocId
          && d.role == 'MEMBER'
          && d.email in getAfter(fundPath(fundId)).data.memberEmails
          && memberKeysValid(d);
      }

      // The admin manages other members; their own record must stay ACTIVE
      // until ownership has been transferred.
      function isAdminMemberUpdate() {
        let fund = get(fundPath(fundId)).data;
        let after = request.resource.data;
        return isAdminOf(fund)
          && changed().hasOnly(['role', 'status', 'lastActiveAt', 'updatedAt', 'name', 'phone'])
          && after.role in ['ADMIN', 'MEMBER']
          && after.status in ['PENDING', 'ACTIVE', 'INACTIVE', 'LEFT']
          && (resource.data.email.lower() != fund.adminEmail.lower() || after.status == 'ACTIVE');
      }

      // A member may edit their own contact details or leave. The admin
      // cannot leave without transferring ownership first.
      function isSelfMemberUpdate() {
        let fund = get(fundPath(fundId)).data;
        return isMemberOf(fund)
          && resource.data.email.lower() == myEmail()
          && changed().hasOnly(['status', 'lastActiveAt', 'name', 'phone'])
          && (!changed().hasAny(['status'])
              || (request.resource.data.status == 'LEFT' && !isAdminOf(fund)));
      }

      // Per-member aggregates move only with the deposit named in the fund's
      // lastTxId: up by its amount when it is created, down when it is reversed.
      // The deposit rules check the reverse direction (Invariant 2).
      function isContributionChange(memberDocId) {
        let before = resource.data;
        let after = request.resource.data;
        let path = txPath(fundId, 'deposits', getAfter(fundPath(fundId)).data.lastTxId);
        let delta = after.totalContributed - before.get('totalContributed', 0);
        let countDelta = after.depositCount - before.get('depositCount', 0);
        return isMemberOf(get(fundPath(fundId)).data)
          && changed().hasOnly(['totalContributed', 'depositCount'])
          && existsAfter(path)
          && getAfter(path).data.memberId == memberDocId
          && ((!exists(path)
               && delta == getAfter(path).data.amount
               && countDelta == 1)
              || (exists(path)
               && get(path).data.get('isVoid', false) == false
               && getAfter(path).data.isVoid == true
               && delta == -get(path).data.amount
               && countDelta == -1));
      }

      function isMemberSelf(memberDocId) {
        return hasEmail()
          && exists(memberPath(fundId, memberDocId))
          && get(memberPath(fundId, memberDocId)).data.email.lower() == myEmail();
      }

      match /members/{memberDocId} {
        allow read: if isMemberOf(get(fundPath(fundId)).data);
        allow create: if isCreatorMemberCreate(memberDocId) || isInviteCreate(memberDocId);
        allow update: if isAdminMemberUpdate() || isSelfMemberUpdate()
                      || isContributionChange(memberDocId);
        allow delete: if false;

        // Strictly Admin-or-owner KYC identity PII
        match /kyc/{kycDocId} {
          function kycKeysValid(d) {
            return kycDocId == 'identity'
              && d.keys().hasOnly(['userId', 'nidNumber', 'nomineeName', 'nomineePhone',
                                   'nomineeRelation', 'verifiedByAdmin', 'updatedAt'])
              && d.get('userId', memberDocId) == memberDocId;
          }

          allow read: if kycDocId == 'identity'
                      && (isAdminOf(get(fundPath(fundId)).data) || isMemberSelf(memberDocId));
          // Only the admin can mark identity as verified; an owner edit resets it.
          allow create, update: if kycKeysValid(request.resource.data)
                                && (isAdminOf(get(fundPath(fundId)).data)
                                    || (isMemberSelf(memberDocId)
                                        && request.resource.data.get('verifiedByAdmin', false) == false));
          allow delete: if false;
        }
      }

      // -------------------------------------------------------------
      // Ledger subcollections (Invariants 1, 2, 4)
      // -------------------------------------------------------------
      function validLedgerCreate(txId, idField, dateField) {
        let d = request.resource.data;
        let fund = get(fundPath(fundId)).data;
        return isMemberOf(fund)
          && fund.isLocked == false
          && d[idField] == txId
          && d.fundId == fundId
          && isWholeAmount(d.amount)
          && notInFuture(d[dateField])
          && d.get('isVoid', false) == false
          && d.get('voidReason', null) == null
          && d.get('voidedAt', null) == null
          && d.get('voidedBy', null) == null
          && getAfter(fundPath(fundId)).data.lastTxId == txId;
      }

      function validVoidUpdate(txId) {
        let after = request.resource.data;
        return isAdminOf(get(fundPath(fundId)).data)
          && changed().hasOnly(['isVoid', 'voidReason', 'voidedBy', 'voidedAt'])
          && resource.data.get('isVoid', false) == false
          && after.isVoid == true
          && after.voidReason is string && after.voidReason.size() >= 5
          && after.voidedAt is int
          && after.voidedBy is string && after.voidedBy.lower() == myEmail()
          && getAfter(fundPath(fundId)).data.lastTxId == txId;
      }

      // The contributing member's totals must move by the same amount in the same write.
      function memberTotalMovesBy(memberDocId, amount) {
        let member = memberPath(fundId, memberDocId);
        return exists(member)
          && getAfter(member).data.totalContributed
             == get(member).data.get('totalContributed', 0) + amount;
      }

      match /deposits/{depositId} {
        allow read: if isMemberOf(get(fundPath(fundId)).data);
        allow create: if validLedgerCreate(depositId, 'depositId', 'depositDate')
                      && getAfter(fundPath(fundId)).data.totalDeposits
                         == get(fundPath(fundId)).data.totalDeposits + request.resource.data.amount
                      && memberTotalMovesBy(request.resource.data.memberId, request.resource.data.amount);
        allow update: if validVoidUpdate(depositId)
                      && getAfter(fundPath(fundId)).data.totalDeposits
                         == get(fundPath(fundId)).data.totalDeposits - resource.data.amount
                      && memberTotalMovesBy(resource.data.memberId, -resource.data.amount);
        allow delete: if false; // Financial records are immutable; reversal protocol only
      }

      match /expenses/{expenseId} {
        allow read: if isMemberOf(get(fundPath(fundId)).data);
        allow create: if isAdminOf(get(fundPath(fundId)).data)
                      && validLedgerCreate(expenseId, 'expenseId', 'expenseDate')
                      && getAfter(fundPath(fundId)).data.totalExpenses
                         == get(fundPath(fundId)).data.totalExpenses + request.resource.data.amount;
        allow update: if validVoidUpdate(expenseId)
                      && getAfter(fundPath(fundId)).data.totalExpenses
                         == get(fundPath(fundId)).data.totalExpenses - resource.data.amount;
        allow delete: if false; // Financial records are immutable; reversal protocol only
      }

      // Append-only audit log, writable only by members of this circle.
      match /audit_logs/{logId} {
        allow read: if isMemberOf(get(fundPath(fundId)).data);
        allow create: if isMemberOf(get(fundPath(fundId)).data)
                      && request.resource.data.get('actorEmail', myEmail()).lower() == myEmail();
        allow update, delete: if false;
      }
    }

    // User profile & invitations: owner only
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;

      match /invitations/{invitationId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // Default deny: all unmapped paths are rejected
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
