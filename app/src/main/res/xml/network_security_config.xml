<?xml version="1.0" encoding="utf-8"?>
<!--
    Release config: cleartext HTTP is prohibited for every host, loopback included.
    Debug builds use src/debug/res/xml/network_security_config.xml, which adds the emulator hosts.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
