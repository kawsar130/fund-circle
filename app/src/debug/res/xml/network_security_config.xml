<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug builds only. This file replaces src/main/res/xml/network_security_config.xml in the debug
    variant, so release builds never allow cleartext traffic to any host.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Trust user-installed CAs (e.g. a proxy for traffic inspection) in debuggable builds -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>

    <!-- Permit cleartext HTTP only to the local Firebase Emulator Suite on loopback -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
